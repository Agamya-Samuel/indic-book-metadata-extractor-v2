# Environment variables for Indic Book Metadata Extractor
# Copy this file to .env and update values as needed

# Application
APP_NAME=Indic Book Metadata Extractor
DEBUG=true

# Database (used by Docker Compose services)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/indic_books

# Redis
REDIS_URL=redis://redis:6379/0

# Ollama LLM Server
OLLAMA_URL=http://ollama:11434

# File Storage
STORAGE_PATH=/app/storage

# Upload Limits
MAX_UPLOAD_SIZE_MB=200

# OCR
TESSERACT_CMD=tesseract
DEFAULT_OCR_LANGUAGE=tel
