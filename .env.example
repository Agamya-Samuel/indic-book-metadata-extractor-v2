# Environment variables for Indic Book Metadata Extractor
# Copy this file to .env and update values as needed

# Application
APP_NAME=Indic Book Metadata Extractor
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database (Docker Compose default — use localhost for local dev)
# WARNING: Never use default credentials in production. Use a strong password.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/indic_books
# For local development without Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/indic_books

# Redis (Docker Compose default — use localhost for local dev)
REDIS_URL=redis://redis:6379/0
# Celery result backend (separate Redis DB from broker)
CELERY_RESULT_BACKEND=redis://redis:6379/1
# For local development without Docker:
# REDIS_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Ollama LLM Server (Docker Compose default — use localhost for local dev)
OLLAMA_URL=http://ollama:11434
# For local development without Docker:
# OLLAMA_URL=http://localhost:11434

# File Storage
STORAGE_PATH=/app/storage
# For local development without Docker:
# STORAGE_PATH=./storage

# Upload Limits
MAX_UPLOAD_SIZE_MB=200

# OCR
TESSERACT_CMD=tesseract
DEFAULT_OCR_LANGUAGE=tel

# ──────────────────────────────────────────────────────────────────────────────
# New Relic Monitoring
# The frontend uses the `newrelic` Node.js agent (hybrid OTel mode) which
# injects the browser monitoring snippet server-side via getBrowserTimingHeader().
# The backend uses the Python APM agent. Infrastructure runs as a Docker sidecar.
# See docs/monitoring.md for the full setup guide.
# ──────────────────────────────────────────────────────────────────────────────

# Master toggle — set to true to enable all New Relic agents
NEW_RELIC_ENABLED=false

# License key (get from https://one.newrelic.com → API Keys)
NEW_RELIC_LICENSE_KEY=

# Application name shown in the New Relic dashboard
NEW_RELIC_APP_NAME=Indic Book Metadata Extractor (Dev)

# Environment label (production, staging, local)
NEW_RELIC_ENVIRONMENT=local

# Distributed tracing — links traces across frontend → backend → Celery
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# Agent log level (off, error, warning, info, debug, finest)
NEW_RELIC_LOG=error

# OpenTelemetry mode (required for hybrid agent with Next.js)
NEW_RELIC_OPENTELEMETRY_ENABLED=true

# ── Backend APM Agent ─────────────────────────────────────────────────────────
# Path to newrelic.ini (auto-generated by the agent, usually no change needed)
NEW_RELIC_CONFIG_FILE=newrelic.ini

# Enable/disable the APM agent process (true/false)
NEW_RELIC_MONITOR_MODE=true

# Reduced overhead for dev — no data sent to New Relic (true/false)
NEW_RELIC_DEVELOPER_MODE=false

# ── Infrastructure Agent (Docker sidecar) ─────────────────────────────────────
# These are used by the newrelic-infra container in docker-compose.yml.
# NRIA_LICENSE_KEY defaults to NEW_RELIC_LICENSE_KEY if not set.
NRIA_DISPLAY_NAME=indic-book-extractor-host
NRIA_LOG=info
