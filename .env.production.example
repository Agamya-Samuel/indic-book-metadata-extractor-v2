# =============================================================================
# Dokploy Environment Variables — Indic Book Metadata Extractor
# =============================================================================
# Copy these into Dokploy → Service → Environment tab.
# Truly REQUIRED (compose aborts without them): POSTGRES_PASSWORD,
# JWT_SECRET_KEY, FRONTEND_URL. Everything else has defaults.
# =============================================================================

# ┌─ REQUIRED ──────────────────────────────────────────────────────────────────┐
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ RECOMMENDED ───────────────────────────────────────────────────────────────┐

# API base path, relative — the frontend and API share one public origin and
# the reverse proxy routes /api to the backend. Never point this at a second
# subdomain: the CSRF cookie is host-only, so a split origin breaks every
# mutation with 403.
NEXT_PUBLIC_API_URL=/api

# CORS — set to your actual domain(s), comma-separated
CORS_ORIGINS=https://YOUR_DOMAIN

# OpenRefine public URL (used in the Bulk Operations page link)
NEXT_PUBLIC_OPENREFINE_URL=https://openrefoki.YOUR_DOMAIN

# Flower dashboard basic auth
FLOWER_BASIC_AUTH=admin:CHANGE_ME

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ WIKIBASE ──────────────────────────────────────────────────────────────────┐

# Public host for Wikibase (used by OpenRefine and for QuickStatements URLs)
WIKIBASE_HOST=wikoki.YOUR_DOMAIN
WIKIBASE_SCHEME=https

# Wikibase admin password (must be at least 10 characters)
WIKIBASE_ADMIN_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD

# MySQL credentials for Wikibase database
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ OPTIONAL (defaults work out of the box) ───────────────────────────────────┐

# App
# APP_NAME=Indic Book Metadata Extractor
# DEBUG=false
# MAX_UPLOAD_SIZE_MB=200

# OCR
# DEFAULT_OCR_LANGUAGE=tel

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ NEW RELIC (disabled by default — uncomment to enable) ─────────────────────┐
#
# NEW_RELIC_ENABLED=true
# NEW_RELIC_LICENSE_KEY=your_nr_license_key
# NEW_RELIC_APP_NAME=Indic Book Metadata Extractor
# NEW_RELIC_ENVIRONMENT=production
# NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
# NEW_RELIC_LOG=error
# NEW_RELIC_MONITOR_MODE=true
# NEW_RELIC_DEVELOPER_MODE=false
#
# Frontend browser agent (from New Relic → Browser → App settings):
# NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY=NRJS-xxxxx
# NEXT_PUBLIC_NEW_RELIC_APP_ID=123456
# NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=123456

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ AUTHENTICATION & EMAIL (required) ────────────────────────────────────────┐
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_SECRET
COOKIE_SECURE=true
FRONTEND_URL=https://your-domain.example
# SMTP for verification and password-reset emails
SMTP_ENABLED=true
SMTP_HOST=mx.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
SMTP_USE_TLS=false
# └─────────────────────────────────────────────────────────────────────────────┘
