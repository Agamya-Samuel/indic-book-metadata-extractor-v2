# =============================================================================
# Dokploy Environment Variables — Indic Book Metadata Extractor
# =============================================================================
# Copy these into Dokploy → Service → Environment tab.
# Truly REQUIRED (compose aborts without them): POSTGRES_PASSWORD,
# JWT_SECRET_KEY, FRONTEND_URL. Everything else has defaults.
# =============================================================================

# ┌─ REQUIRED ──────────────────────────────────────────────────────────────────┐
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ RECOMMENDED ───────────────────────────────────────────────────────────────┐

# API base path, relative — the frontend and API share one public origin and
# the reverse proxy routes /api to the backend. Never point this at a second
# subdomain: the CSRF cookie is host-only, so a split origin breaks every
# mutation with 403.
NEXT_PUBLIC_API_URL=/api

# CORS — set to your actual domain(s), comma-separated
CORS_ORIGINS=https://openbookmap.oki-india.org

# Canonical public origin used for metadataBase, OpenGraph, sitemap and robots.
# Defaults to FRONTEND_URL when unset.
NEXT_PUBLIC_SITE_URL=https://openbookmap.oki-india.org

# OpenRefine public URL (used in the Bulk Operations page link)
NEXT_PUBLIC_OPENREFINE_URL=https://openrefoki.YOUR_DOMAIN

# External monitoring links shown on Admin → System. These are baked into the
# frontend bundle at BUILD time, so changing them requires a frontend rebuild
# (Dokploy → Redeploy). Leave empty to hide a link.
NEXT_PUBLIC_BETTERSTACK_URL=https://obm-status.YOUR_DOMAIN
NEXT_PUBLIC_NEW_RELIC_URL=

# Flower dashboard basic auth
FLOWER_BASIC_AUTH=admin:CHANGE_ME

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ WIKIBASE ──────────────────────────────────────────────────────────────────┐

# Public host for Wikibase. This is the canonical $wgServer origin (RDF IRIs,
# OAuth callbacks) and is NOT used to reach Wikibase from inside compose —
# containers always use http://wikibase/w/api.php.
WIKIBASE_HOST=wikibase.YOUR_DOMAIN
WIKIBASE_SCHEME=https
# Public origin of the QuickStatements service (links generated in the UI)
QUICKSTATEMENTS_PUBLIC_URL=https://quickstatements.YOUR_DOMAIN

# Wikibase admin password (must be at least 10 characters)
WIKIBASE_ADMIN_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD

# Bot account for automated publishing (Special:BotPasswords).
WIKIBASE_BOT_USERNAME=
WIKIBASE_BOT_PASSWORD=

# MySQL credentials for Wikibase database
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ OPTIONAL (defaults work out of the box) ───────────────────────────────────┐

# App
# APP_NAME=Indic Book Metadata Extractor
# DEBUG=false
# MAX_UPLOAD_SIZE_MB=200

# LLM endpoint — production runs gemma4:e4b, which requires Ollama's native
# /api/chat so `think:false` is honoured. The compose default is true; set
# false only if you roll back to phi4-mini on the /v1 path.
# LLM_NATIVE_ENDPOINT=true

# OCR
# Telugu engine: production defaults to "line_model" (baked into the worker
# image with torch + the 310 MB weights); Hindi/English always use Tesseract.
# Set "tesseract" to roll back.
# OCR_TEL_ENGINE=line_model

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ NEW RELIC (disabled by default — uncomment to enable) ─────────────────────┐
#
# NEW_RELIC_ENABLED=true
# NEW_RELIC_LICENSE_KEY=your_nr_license_key
# NEW_RELIC_APP_NAME=Indic Book Metadata Extractor
# NEW_RELIC_ENVIRONMENT=production
# NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
# NEW_RELIC_LOG=error
# NEW_RELIC_MONITOR_MODE=true
# NEW_RELIC_DEVELOPER_MODE=false
#
# Frontend browser agent (from New Relic → Browser → App settings):
# NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY=NRJS-xxxxx
# NEXT_PUBLIC_NEW_RELIC_APP_ID=123456
# NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=123456

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ AUTHENTICATION & EMAIL (required) ────────────────────────────────────────┐
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_SECRET
# Encrypts the admin-configured SMTP password stored in the database. Keep it
# stable; it falls back to JWT_SECRET_KEY when empty.
ENCRYPTION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_SECRET
COOKIE_SECURE=true
FRONTEND_URL=https://openbookmap.oki-india.org
# SMTP for verification and password-reset emails.
# Admins can override these at runtime from Admin -> System -> Email (SMTP);
# settings saved there take precedence over these values.
# Resend over raw SMTP: point the existing SMTP_* variables at Resend's
# endpoint — SMTP_USERNAME is "resend" and SMTP_PASSWORD is the Resend API key.
SMTP_ENABLED=true
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@your-verified-domain
SMTP_STARTTLS=true
SMTP_USE_TLS=false
# └─────────────────────────────────────────────────────────────────────────────┘
