# =============================================================================
# Dokploy Staging Environment Variables — Indic Book Metadata Extractor
# =============================================================================
# Copy into Dokploy → Service → Environment tab.
#
# Domains MUST be different from production. Using the same domain for both
# will cause Traefik routing conflicts and Let's Encrypt failures.
#
# All secrets MUST be different from production. Re-using production
# credentials in staging defeats the purpose of a staging environment.
# =============================================================================

# ┌─ REQUIRED ──────────────────────────────────────────────────────────────────┐
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ DOMAINS (must be unique per environment) ───────────────────────────────────┐

# Frontend + Backend public domain
NEXT_PUBLIC_API_URL=https://staging-api.YOUR_DOMAIN/api
CORS_ORIGINS=https://staging.YOUR_DOMAIN

# OpenRefine public URL
NEXT_PUBLIC_OPENREFINE_URL=https://staging-openrefine.YOUR_DOMAIN

# Wikibase public host (used internally by Wikibase + QuickStatements)
WIKIBASE_HOST=staging-wikibase.YOUR_DOMAIN
WIKIBASE_SCHEME=https
QUICKSTATEMENTS_PUBLIC_URL=https://staging-quickstatements.YOUR_DOMAIN

# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ AUTH (different from production) ───────────────────────────────────────────┐
FLOWER_BASIC_AUTH=admin:CHANGE_ME_STAGING_FLOWER
WIKIBASE_ADMIN_PASS=CHANGE_ME_STAGING_WIKIBASE_ADMIN
MYSQL_PASSWORD=CHANGE_ME_STAGING_MYSQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_STAGING_MYSQL_ROOT

# MediaWiki secret keys — REQUIRED for Wikibase session security
# Generate with: openssl rand -hex 32
MW_SECRET_KEY=CHANGE_ME_STAGING_MW_SECRET
MW_UPGRADE_KEY=CHANGE_ME_STAGING_MW_UPGRADE
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ APP TUNING ────────────────────────────────────────────────────────────────┐
APP_NAME="Indic Book Metadata Extractor (staging)"
DEBUG=true
MAX_UPLOAD_SIZE_MB=200
DEFAULT_OCR_LANGUAGE=tel
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ NEW RELIC (recommended even for staging — use a separate app) ─────────────┐
#
# NEW_RELIC_ENABLED=true
# NEW_RELIC_LICENSE_KEY=your_nr_license_key
# NEW_RELIC_APP_NAME=Indic Book Metadata Extractor (staging)
# NEW_RELIC_ENVIRONMENT=staging
# NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
# NEW_RELIC_LOG=info
#
# Frontend browser agent (optional):
# NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY=NRJS-xxxxx
# NEXT_PUBLIC_NEW_RELIC_APP_ID=123456
# NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=123456
# └─────────────────────────────────────────────────────────────────────────────┘
