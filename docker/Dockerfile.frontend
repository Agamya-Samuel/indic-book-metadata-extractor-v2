FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Accept NEXT_PUBLIC_* build args so they're baked into the client bundle.
# These are used as fallback for browser monitoring when the APM agent
# hasn't received the browser JS from the collector yet.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY
ARG NEXT_PUBLIC_NEW_RELIC_APP_ID
ARG NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY=${NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY}
ENV NEXT_PUBLIC_NEW_RELIC_APP_ID=${NEXT_PUBLIC_NEW_RELIC_APP_ID}
ENV NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=${NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID}

# New Relic agent config — needed at runtime by the `newrelic` Node.js agent.
ARG NEW_RELIC_ENABLED=false
ARG NEW_RELIC_LICENSE_KEY
ARG NEW_RELIC_APP_NAME="Indic Book Metadata Extractor"
ENV NEW_RELIC_ENABLED=${NEW_RELIC_ENABLED}
ENV NEW_RELIC_LICENSE_KEY=${NEW_RELIC_LICENSE_KEY}
ENV NEW_RELIC_APP_NAME=${NEW_RELIC_APP_NAME}

RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# New Relic agent config (not included in standalone trace automatically)
COPY --from=builder /app/newrelic.cjs ./newrelic.cjs

# Create log file with proper permissions for the nextjs user
RUN touch /app/newrelic_agent.log && chown nextjs:nodejs /app/newrelic_agent.log

USER nextjs
EXPOSE 3000
ENV PORT=3000

CMD ["node", "server.js"]
