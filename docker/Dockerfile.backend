FROM python:3.11-slim

# System dependencies for Tesseract, OpenCV, and PDF processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-osd \
    tesseract-ocr-tel \
    tesseract-ocr-hin \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install indic-ocr tessdata — script-aware retrained models for Indic scripts.
# The repo stores .traineddata files inside per-language subdirectories
# (ben/, guj/, hin/, kan/, mal/, mni/, ori/, pan/, sat/, tam/, tel/), not at
# the repository root. Pin via TESSDATA_REF (commit SHA) so builds are
# reproducible. Override with --build-arg TESSDATA_REF=<sha> to roll forward.
ARG TESSDATA_REF=master
RUN mkdir -p /usr/share/tesseract-ocr/5/tessdata \
    && cd /tmp \
    && git clone --depth 1 --branch ${TESSDATA_REF} https://github.com/indic-ocr/tessdata.git indic-tessdata \
    && find /tmp/indic-tessdata -name '*.traineddata' -exec cp {} /usr/share/tesseract-ocr/5/tessdata/ \; \
    && rm -rf /tmp/indic-tessdata \
    && ls /usr/share/tesseract-ocr/5/tessdata/

ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app

# Install Python dependencies
COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev

# Copy application code
COPY app/ app/
COPY alembic/ alembic/
COPY alembic.ini alembic.ini
COPY newrelic.ini newrelic.ini

# Create storage directories
RUN mkdir -p /app/storage/uploads /app/storage/thumbnails /app/storage/pages /app/storage/processed /app/storage/models /app/storage/training_data

EXPOSE 8000

CMD ["uv", "run", "newrelic-admin", "run-program", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]