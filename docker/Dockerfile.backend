FROM python:3.11-slim

# System dependencies for Tesseract, OpenCV, and PDF processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-osd \
    tesseract-ocr-tel \
    tesseract-ocr-hin \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Stock Tesseract models are installed via apt-get above (tesseract-ocr-tel, tesseract-ocr-hin, tesseract-ocr-eng).
# No additional model installation needed - using the official Tesseract models.

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app

# Install Python dependencies
COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev

# Copy application code
COPY app/ app/
COPY alembic/ alembic/
COPY alembic.ini alembic.ini
COPY newrelic.ini newrelic.ini

# Create storage directories
RUN mkdir -p /app/storage/uploads /app/storage/thumbnails /app/storage/pages /app/storage/processed /app/storage/models /app/storage/training_data

EXPOSE 8000

CMD ["uv", "run", "newrelic-admin", "run-program", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]