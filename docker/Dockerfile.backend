# Pinned by digest. `python:3.11-slim` is a mutable tag that Debian re-publishes;
# when its digest moves every later layer is invalidated, so a frontend-only
# deploy silently rebuilds this image from scratch (and can silently move the
# runtime onto a new Debian release). Bump deliberately with:
#   docker buildx imagetools inspect python:3.11-slim
FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

# System dependencies for Tesseract, OpenCV, and PDF processing.
# The deploy host cannot pull from deb.debian.org (measured ~60 KB/s with stalls
# and apt retries; this step ran past 30 minutes). IIT Kanpur's mirror reached
# ~12 MB/s from that same host, so point the sources at it first. The Debian
# archive is signature-verified, so plain http is not a weaker guarantee here;
# this mirror serves no https.
RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
      if [ -f "$f" ]; then \
        sed -i \
          -e 's|https://deb.debian.org/debian|http://mirror.cse.iitk.ac.in/debian|g' \
          -e 's|http://deb.debian.org/debian|http://mirror.cse.iitk.ac.in/debian|g' \
          "$f"; \
      fi; \
    done; \
    apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-osd \
    tesseract-ocr-tel \
    tesseract-ocr-hin \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Stock Tesseract models are installed via apt-get above (tesseract-ocr-tel, tesseract-ocr-hin, tesseract-ocr-eng).
# No additional model installation needed - using the official Tesseract models.

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app

# Install Python dependencies
COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev

# Copy application code
COPY app/ app/
COPY alembic/ alembic/
COPY alembic.ini alembic.ini
COPY newrelic.ini newrelic.ini

# Create storage directories
RUN mkdir -p /app/storage/uploads /app/storage/thumbnails /app/storage/pages /app/storage/processed /app/storage/models /app/storage/training_data

EXPOSE 8000

CMD ["uv", "run", "newrelic-admin", "run-program", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]